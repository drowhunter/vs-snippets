<?xml version="1.0" encoding="utf-8"?>
<CodeSnippet Format="1.0.0">
  <Header>
    <Title>Positional Record</Title>
    <Shortcut>rec</Shortcut>
    <Description>Creates a positional record with file-scoped namespace.</Description>
    <Author>Trevor</Author>
  </Header>
  <Snippet>
    <Declarations>
      <Literal>
        <ID>name</ID>
        <ToolTip>Record name</ToolTip>
        <Default>MyRecord</Default>
      </Literal>
      <Literal>
        <ID>properties</ID>
        <ToolTip>Positional parameters</ToolTip>
        <Default>string Name</Default>
      </Literal>
    </Declarations>
    <Code Language="csharp">
      <![CDATA[
namespace $namespace$;

public record $name$($properties$);
]]>
    </Code>
  </Snippet>
</CodeSnippet>
